# Local environment and OS files
.env
.env.*
!.env.example
/Data/Database.json
/Data/GoogleAuth.json
.DS_Store
Thumbs.db
Desktop.ini

# Required toolchain files are intentionally committed.
# Do not add generic bin/, Debug/, Release/, *.exe, or *.lib rules.
!/Common/protoc-21.12-win64/bin/
!/Common/protoc-21.12-win64/bin/**
!/Libraries/Libs/Protobuf/Debug/
!/Libraries/Libs/Protobuf/Debug/*.lib
!/Libraries/Libs/Protobuf/Release/
!/Libraries/Libs/Protobuf/Release/*.lib
